# ═════════════════════════════════════════════════════════════
#  Driony · Producción (docker-compose.prod.yml)
# ═════════════════════════════════════════════════════════════
#
#  1. En el VPS, dentro de la carpeta del proyecto:
#       cp .env.example.production .env
#
#  2. Genera los secretos (formato hex: "+", "/" o "=" rompen DATABASE_URL):
#       for k in DB_PASSWORD JWT_ACCESS_SECRET AUTH_SECRET LEAD_WEBHOOK_TOKEN; do
#         sed -i "s/^$k=CAMBIAR$/$k=$(openssl rand -hex 32)/" .env
#       done
#
#  3. Levanta:
#       docker compose -f docker-compose.prod.yml up -d --build
#
#  En el VPS usa SIEMPRE -f docker-compose.prod.yml. El docker-compose.yml
#  es solo de desarrollo: publica Postgres (5433) y Redis (6379, sin
#  contraseña) a internet.
#
#  No edites este archivo desde Windows sin cuidado: los saltos de línea
#  "\r" hacen que las variables se lean mal. Si pasa: sed -i 's/\r$//' .env
#
#  DATABASE_URL y API_URL NO van aquí: el compose las arma con la red interna.
# ═════════════════════════════════════════════════════════════

# ── Base de datos ────────────────────────────────────────────
# Postgres solo usa la contraseña al CREAR el volumen por primera vez.
# Si la base ya existe, pon aquí la contraseña con la que se creó.
DB_USER=crm
DB_PASSWORD=CAMBIAR
DB_NAME=crm

# ── URLs públicas ────────────────────────────────────────────
# Un solo dominio: Nginx Proxy Manager manda /api/v1, /api/public,
# /api/docs y /socket.io a crm-api:3001, y el resto a crm-web:3000.
WEB_ORIGIN=https://crm.flyteek.com
AUTH_URL=https://crm.flyteek.com
# Se hornea en la imagen del frontend: si lo cambias, reconstruye con --build.
NEXT_PUBLIC_API_URL=https://crm.flyteek.com

# ── Autenticación ────────────────────────────────────────────
# Cambiar JWT_ACCESS_SECRET cierra todas las sesiones y obliga a volver a
# introducir las API keys de IA (se cifran con una clave derivada de él).
JWT_ACCESS_SECRET=CAMBIAR
AUTH_SECRET=CAMBIAR
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# La primera cuenta registrada en https://crm.flyteek.com/register queda
# como ADMIN. Regístrate tú antes de compartir la URL.

# ── Webhook de leads entrantes ───────────────────────────────
LEAD_WEBHOOK_TOKEN=CAMBIAR

# ── IA (opcional: lo normal es configurarla en Ajustes › IA) ─
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
VOYAGE_API_KEY=

# ── WhatsApp Cloud API (opcional: se conecta desde el panel) ─
# Webhook para Meta: https://crm.flyteek.com/api/v1/whatsapp/webhook
WHATSAPP_APP_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Dirección pública de la API, solo si NO es https://api.<SAAS_BASE_DOMAIN>.
# Se usa para la URL del webhook de la app propia de cada empresa.
# API_PUBLIC_URL=
WHATSAPP_GRAPH_VERSION=v24.0
# Embedded Signup en el frontend (se hornean en la imagen: --build)
NEXT_PUBLIC_WHATSAPP_APP_ID=
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=

# ── Marca ────────────────────────────────────────────────────
NEXT_PUBLIC_COMPANY_NAME=Driony
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Red de Nginx Proxy Manager ───────────────────────────────
# Red del contenedor de NPM (en este VPS se llama n8n-app-1). Compruébala:
#   docker inspect n8n-app-1 --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
# Si no coincide, compose falla con "network ... declared as external, but
# could not be found".
PROXY_NETWORK=n8n_default

# Cuenta maestra de la plataforma: entra en admin.<dominio> (todas las
# empresas, altas, planes, suspender). No pertenece a ninguna empresa.
# Genera el hash con:  npm run platform:password -- "una-contraseña-larga"
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD_HASH=""

# ── Base de datos (PostgreSQL con pgvector) ──────────────────
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# ── Backend NestJS ───────────────────────────────────────────
API_PORT=3001
# Origen del frontend permitido por CORS
WEB_ORIGIN="http://localhost:3000"

# Auth (JWT). En prod usa un secreto largo y aleatorio.
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_ACCESS_TTL="15m"
# TTL del refresh token (rotativo) en días
REFRESH_TTL_DAYS=30

# ── IA (proveedor del LLM) ───────────────────────────────────
# Solo en el backend/worker. Nunca en el frontend.
# Estas variables son el RESPALDO: lo normal es configurar la key desde
# la UI en Ajustes › Inteligencia Artificial (se guarda cifrada en la BD).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Modelo para describir las fotos que mandan los clientes. Por defecto gpt-4.1-mini
# (una foto ≈ 400 tokens; con gpt-4o-mini la misma foto cuesta ≈ 2.800).
# AI_VISION_MODEL="gpt-4.1-mini"
# Los stickers no se describen (el agente ve «[sticker]»). Para describirlos: AI_DESCRIBE_STICKERS="on"
# SaaS (TENANCY_MODE=multi): las keys de arriba son de la PLATAFORMA y por
# defecto NO se prestan a las empresas: cada una pone la suya en Ajustes › IA
# y paga su consumo a su proveedor. Ponlo en "true" para que las empresas sin
# key usen las de la plataforma (ese consumo lo pagas tú; el tope mensual por
# agente sigue aplicando).
AI_SHARED_KEYS=""
# SaaS: IA de Driony incluida en el plan. Con "true", una empresa sin key
# propia usa OPENAI_API_KEY con el modelo fijo (gpt-5-mini, o AI_INCLUDED_MODEL)
# y un cupo de conversaciones al mes según su plan (plans.ts), más un tope en
# dólares. Agotado, el agente pasa los chats al equipo. Vacío o "false" la
# apaga al instante (interruptor de emergencia). AI_SHARED_KEYS=true la anula:
# ese modo presta la key sin cupo.
AI_INCLUDED=""
# AI_INCLUDED_MODEL="gpt-5-mini"
# Solo si usas un gateway compatible con OpenAI. DÉJALA COMENTADA si usas la
# API oficial: definirla vacía es equivalente, pero es más claro no tenerla.
# OPENAI_BASE_URL="https://mi-gateway.example.com/v1"

# Clave para cifrar las API keys guardadas en la BD. Si no la defines se
# deriva de JWT_ACCESS_SECRET. Si la cambias, hay que reintroducir las keys.
# APP_ENCRYPTION_KEY=""

# ── Embeddings para RAG (Voyage AI) ──────────────────────────
VOYAGE_API_KEY=""

# ── WhatsApp Cloud API (Meta) ────────────────────────────────
# Con una sola empresa, estas credenciales también se pueden poner desde
# Ajustes › Integraciones (la base manda; el .env es el respaldo).
#
# En modo multi (SaaS) NO: aquí hay UNA app de Meta, la de la plataforma, que
# firma los webhooks de todos los clientes. Y esos webhooks llegan antes de
# saber de qué empresa son, así que APP_SECRET, VERIFY_TOKEN y APP_ID se leen
# SIEMPRE de aquí. Cada cliente conecta su número por Embedded Signup; el
# WHATSAPP_TOKEN de abajo es de la plataforma y ningún cliente envía con él.
# (Un cliente también puede usar su PROPIA app de Meta: la guarda en Ajustes ›
# Integraciones y apunta su webhook a su-empresa.<dominio>/api/v1/webhooks/whatsapp.)
#
# El SDK de JavaScript de Meta solo arranca en dominios listados en la app.
# En modo multi carga siempre en el dominio raíz (driony.com/connect/…), así
# que en Meta basta con listar ese dominio una vez: App Domains y Allowed
# Domains for the JavaScript SDK → tu SAAS_BASE_DOMAIN.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# SaaS: ¿Meta ya aprobó a la plataforma como proveedor tecnológico (acceso
# avanzado a la API de WhatsApp)? Hasta que sea "true", las empresas ven en
# WhatsApp un aviso de «en revisión por Meta» en vez del botón «Conectar
# WhatsApp», que para ellas acabaría en el error #2655111. Solo cuenta en multi.
WHATSAPP_TECH_PROVIDER_APPROVED=""

# ── Modo de organización ─────────────────────────────────────
# "single" (por defecto): una sola empresa. Es la versión open source y se usa
#   exactamente igual que siempre; el CRM crea su organización solo.
# "multi": modo SaaS, una empresa por subdominio. Cada petición tiene que traer
#   su organización o falla — sin valor por defecto, que en SaaS sería una fuga.
# TENANCY_MODE="single"

# Dominio bajo el que cuelgan los subdominios de cada empresa, en modo multi.
# Con esto, la empresa "acme" queda en acme.driony.com. Hace falta:
#   · un registro DNS comodín  *.driony.com → tu servidor
#   · un certificado comodín para *.driony.com (reto DNS-01; HTTP-01 no puede
#     emitir comodines)
#   · un proxy host *.driony.com + driony.com → crm-web:3000
#   · otro proxy host api.driony.com → crm-api:3001, con WebSockets activados
# El webhook de la app PROPIA de cada empresa se publica en esa API:
# https://api.<dominio>/api/v1/webhooks/whatsapp/<empresa>. Si la API vive en
# otra dirección, dilo aquí (sin barra final):
# API_PUBLIC_URL=https://api.driony.com
#
# La API necesita subdominio propio: el navegador se conecta a ella para el
# WebSocket y Meta le manda el webhook. No puede quedarse interna.
# Con eso, dar de alta una empresa NO toca DNS, ni certificados, ni el proxy.
# SAAS_BASE_DOMAIN="driony.com"
#
# En modo multi, AUTH_URL tiene que quedar SIN definir. Auth.js lo usaría como
# origen único y, tras entrar en acme.driony.com, redirigiría al dominio raíz,
# donde la cookie de sesión no existe. Con trustHost el origen sale del Host de
# cada petición, que es lo correcto con subdominios. (La app lo ignora si se
# define, avisando en el log, pero mejor no ponerlo.)
#
# Subdominios que ya usas para otra cosa y que ninguna empresa puede registrar.
# Se suman a la lista fija del proyecto. Si hoy sirves el CRM en
# crm.tudominio.com, ponlo aquí: si no, el primer cliente que registre la
# empresa "crm" se queda con tu propia URL.
# RESERVED_SUBDOMAINS_EXTRA="crm,soporte,blog"

# Cuenta maestra de la plataforma (solo en modo multi): entra en
# admin.<dominio> y ve todas las empresas, altas y planes; cambia planes y
# suspende. No pertenece a ninguna empresa. La contraseña va como hash:
#   npm run platform:password -- "una-contraseña-larga"
# Los planes y sus límites están en packages/shared/src/plans.ts.
# PLATFORM_ADMIN_EMAIL="tu@correo.com"
# PLATFORM_ADMIN_PASSWORD_HASH=""

# ── Row-Level Security (capa 2 del aislamiento) ──────────────
# Por defecto se activa solo con TENANCY_MODE=multi. "on"/"off" lo fuerza.
#
# Para que sirva de algo, la aplicación tiene que conectarse con un rol que NO
# sea dueño de las tablas: en Postgres el dueño se salta sus propias políticas.
# Ver scripts/create-app-role.sql. Con el rol de siempre, las políticas existen
# y no hacen nada.
#
# Cuesta: cada consulta pasa a ser una transacción de dos sentencias (medido:
# ~1,2 ms → ~3,6 ms por consulta en local). Por eso no se enciende en una
# instalación de una sola empresa, donde no aísla de nadie.
# DB_RLS="on"

# ── Frontend Next.js ─────────────────────────────────────────
# URL del backend que consume el BFF de Next (server-side)
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
# NextAuth
AUTH_SECRET="cambia-esto-por-otro-secreto-largo"
AUTH_URL="http://localhost:3000"

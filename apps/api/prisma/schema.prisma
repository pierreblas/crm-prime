// CRM para WhatsApp con Agentes IA — esquema Prisma
//
// Notas:
// - pgvector se habilita vía `extensions = [vector]` (preview de Prisma).
// - El campo `embedding` usa `Unsupported("vector(1024)")`: Prisma no lo lee
//   en el cliente ni expresa el índice vectorial. La búsqueda por similitud y
//   el índice (HNSW/IVFFlat) se hacen con SQL crudo (`$queryRaw`) en una
//   migración manual. 1024 dims = Voyage AI `voyage-3.5` (Anthropic no ofrece
//   endpoint de embeddings; se usa un proveedor aparte para el RAG).
// - Auth: NextAuth vive en apps/web con estrategia JWT + Credentials provider.
//   NestJS sigue siendo dueño de `User` y autoridad del JWT. Por eso NO se
//   incluyen las tablas del adapter (Account/Session/VerificationToken):
//   solo harían falta si se agrega OAuth (Google, etc.).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  AGENT
}

enum Platform {
  WEB
  IOS
  ANDROID
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum AiMode {
  AUTOPILOT
  COPILOT
  OFF
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
  LOCATION
  TEMPLATE
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

// Quién originó el mensaje saliente (o el entrante).
enum MessageAuthor {
  CONTACT
  HUMAN
  AI
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  IN_APPEAL
  PENDING_DELETION
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum AiRunStatus {
  RUNNING
  COMPLETED
  ESCALATED
  REFUSED
  ERROR
}

enum AiToolCallStatus {
  PENDING_APPROVAL
  EXECUTED
  REJECTED
  ERROR
}

enum AiMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

// ─────────────────────────────────────────────────────────────
// Auth / Usuarios
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// Organización (raíz multi-inquilino)
// ─────────────────────────────────────────────────────────────

// Toda fila del CRM cuelga de una organización. En la versión open source hay
// una sola, creada por el seed, y no cambia nada de cómo se usa el CRM. En el
// modo SaaS hay una por empresa y `slug` es su subdominio.
//
// La columna `orgId` existe SIEMPRE, en los dos modos. El aislamiento no es una
// función que se enciende: es la forma del esquema. Un esquema que se bifurca
// es un esquema donde la consulta sin filtrar acaba llegando a producción.
model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique // "acme" → acme.driony.com
  name      String
  plan      String   @default("free")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  contacts             Contact[]
  customFields         CustomField[]
  products             Product[]
  productPrices        ProductPrice[]
  productFields        ProductField[]
  sources              Source[]
  tags                 Tag[]
  calls                Call[]
  conversations        Conversation[]
  messages             Message[]
  templates            Template[]
  pipelines            Pipeline[]
  pipelineStages       PipelineStage[]
  deals                Deal[]
  knowledgeDocs        KnowledgeDoc[]
  whatsappConns        WhatsappConnection[]
  apiKeys              ApiKey[]
  webhookSubs          WebhookSubscription[]
  agentConfigs         AgentConfig[]
  flows                Flow[]
  stageAutomations     StageAutomation[]
  stageAutomationRuns  StageAutomationRun[]
  metaPages            MetaPage[]
  quickReplies         QuickReply[]
  aiSetting            AiSetting?
  integrationSetting   IntegrationSetting?
  onboarding           OnboardingState?
  knowledgeSuggestions KnowledgeSuggestion[]
  aiUsage              AiUsage[]

  @@map("organizations")
}

// Consumo de IA: una fila por llamada al modelo, sea del agente, del copiloto,
// de los asistentes, de la clasificación o de los embeddings. Es la fuente del
// informe de consumo de cada empresa; el coste se calcula al leer con la
// tabla de precios de @crm/shared (ai-usage.ts), así un precio corregido
// arregla también el histórico.
model AiUsage {
  id             String   @id @default(cuid())
  orgId          String
  feature        String // agent | classify | copilot | playground | prompt_assistant | flow_assistant | knowledge_gaps | knowledge_index
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  conversationId String?
  createdAt      DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("ai_usage")
}

// Preguntas que los clientes hacen y la base de conocimiento no cubre. Las
// detecta la IA leyendo conversaciones; un humano las aprueba (pasan a ser un
// documento del conocimiento) o las descarta. Las descartadas se recuerdan
// para no volver a proponerlas.
model KnowledgeSuggestion {
  id              String   @id @default(cuid())
  orgId           String
  question        String
  answer          String   @default("")
  occurrences     Int      @default(1)
  conversationIds String[] @default([])
  status          String   @default("pending") // pending | accepted | dismissed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@map("knowledge_suggestions")
}

// Primeros pasos de una empresa nueva. El estado de cada paso se deduce de
// los datos; aquí solo va lo que no se puede deducir (ver @crm/shared
// onboarding.schema.ts).
model OnboardingState {
  id          String    @id @default(cuid())
  orgId       String    @unique
  skipped     String[]  @default([]) // pasos omitidos a mano
  done        String[]  @default([]) // pasos marcados por el sistema (probar el agente)
  dismissedAt DateTime? // la empresa ocultó la lista
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("onboarding_states")
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  email        String
  passwordHash String
  name         String?
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true)
  // Tours guiados de pantalla que ya vio (no se repiten en otro dispositivo).
  toursSeen    String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedConversations Conversation[]   @relation("AssignedAgent")
  approvedToolCalls     AiToolCall[]     @relation("ApprovedBy")
  notes                 Note[]
  calls                 Call[]           @relation("CallAgent")
  sessions              Session[]
  devices               Device[]
  idempotencyKeys       IdempotencyKey[]
  sources               UserSource[] // fuentes que atiende este vendedor
  ownedDeals            Deal[]           @relation("DealOwner")
  apiKeys               ApiKey[]         @relation("ApiKeyCreator")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // El correo es único DENTRO de la empresa, no en toda la instalación: la
  // misma persona puede trabajar en dos empresas distintas. Es lo que obliga a
  // que el acceso sepa de qué empresa es antes de buscar al usuario, y de ahí
  // sale la pantalla de acceso por subdominio.
  @@unique([orgId, email])
  @@index([orgId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Sesiones por dispositivo (auth multi-cliente: web + móvil)
// ─────────────────────────────────────────────────────────────

// Una Session = un login en un dispositivo = una "familia" de refresh tokens.
// El usuario puede listar/revocar sus dispositivos conectados.
model Session {
  id         String    @id @default(cuid())
  userId     String
  platform   Platform
  deviceName String? // "iPhone de Ana", "Chrome en Windows"
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime? // revocación manual o por detección de reuso

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

// Refresh tokens con rotación. En cada refresh se emite uno nuevo y el anterior
// se marca rotado (replacedById). Si se presenta un token ya rotado/revocado
// → reuso detectado → se revoca toda la Session (familia).
model RefreshToken {
  id           String    @id @default(cuid())
  sessionId    String
  tokenHash    String    @unique // se guarda el hash, nunca el token en crudo
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  rotatedAt    DateTime?
  revokedAt    DateTime?
  replacedById String?   @unique

  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([sessionId])
  @@map("refresh_tokens")
}

// Dispositivos para notificaciones push (FCM/APNs). Independiente de Session:
// un device puede tener token incluso sin sesión activa.
model Device {
  id             String   @id @default(cuid())
  userId         String
  platform       Platform
  pushToken      String   @unique // token FCM/APNs
  installationId String? // id estable de instalación del cliente
  isActive       Boolean  @default(true)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

// Idempotencia de mutaciones: el cliente envía una clave única por operación
// (header Idempotency-Key). Reintentos en redes malas (móvil) NO duplican
// envíos de WhatsApp ni creaciones. Se purgan tras `expiresAt`.
model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String
  userId       String
  method       String
  path         String
  requestHash  String // hash del body para detectar misma-clave/distinto-body
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─────────────────────────────────────────────────────────────
// Contactos / Etiquetas
// ─────────────────────────────────────────────────────────────

model Contact {
  id            String    @id @default(cuid())
  orgId         String
  phone         String // E.164 (normalizado: siempre con "+")
  name          String?
  optIn         Boolean   @default(true)
  sourceId      String? // origen COMERCIAL del lead (Facebook Ads, Web…)
  lastMessageAt DateTime?
  metadata      Json? // atributos libres (ciudad, idioma, etc.)
  // Moneda fijada a mano para cotizarle. Null = la de su país, que se deduce
  // del prefijo del teléfono al leer (ver @crm/shared money.ts).
  currency      String?
  // Memoria que la IA mantiene del cliente: resumen y datos clave de todas
  // sus conversaciones. La usa el agente al responder y el copiloto.
  aiMemory      Json? // { summary, facts[] }
  aiMemoryAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ── Procedencia técnica: por qué vía entró al CRM ──────────
  // Distinto de `sourceId` (campaña/canal comercial): esto dice qué API o
  // pantalla creó el contacto, para depurar integraciones.
  origin       String  @default("manual") // ad | whatsapp | webhook | manual | import
  originDetail String? // número de WhatsApp, nombre del webhook, fichero…

  source        Source?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  tags          ContactTag[]
  conversations Conversation[]
  deals         Deal[]
  calls         Call[]
  metaLeads     MetaLead[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, phone])
  @@index([optIn])
  @@index([orgId, lastMessageAt])
  @@index([sourceId])
  @@index([origin])
  @@map("contacts")
}

// Campos personalizados de los contactos/leads. Los valores por contacto se
// guardan en Contact.metadata (JSON), indexados por `key`.
model CustomField {
  id        String   @id @default(cuid())
  orgId     String
  key       String // clave usada en Contact.metadata
  label     String
  type      String   @default("text") // text | number | date | select
  options   String[] // opciones cuando type = select
  order     Int      @default(0)
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@map("custom_fields")
}

// ─────────────────────────────────────────────────────────────
// Catálogo de productos / servicios
// ─────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  sku         String?
  description String?
  price       Decimal  @default(0) @db.Decimal(12, 2)
  currency    String   @default("USD")
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Precios en otras monedas; `price`/`currency` de arriba es el base.
  prices     ProductPrice[]
  // Valores de los campos personalizados de producto (key → valor), según
  // las definiciones de ProductField.
  attributes Json?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, sku])
  @@index([isActive])
  @@map("products")
}

// Campos personalizados de producto (talla, color, material, garantía…).
// Aparte de CustomField, que es de contactos: cada catálogo tiene los suyos.
model ProductField {
  id         String   @id @default(cuid())
  orgId      String
  key        String // clave en Product.attributes
  label      String
  type       String   @default("text") // ver productFieldTypes en @crm/shared
  options    String[]
  unit       String? // "horas", "cupos"… junto a un número
  help       String? // ayuda para el equipo y el agente de IA
  required   Boolean  @default(false)
  showOnCard Boolean  @default(true)
  aiVisible  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@map("product_fields")
}

// Precio explícito de un producto en una moneda distinta de la base. Sin
// conversión automática: el negocio decide cuánto cuesta en cada país.
model ProductPrice {
  id        String  @id @default(cuid())
  orgId     String
  productId String
  currency  String
  amount    Decimal @db.Decimal(12, 2)

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([productId, currency])
  @@index([orgId])
  @@map("product_prices")
}

// ─────────────────────────────────────────────────────────────
// Fuentes (origen del lead) y asignación a vendedores
// ─────────────────────────────────────────────────────────────

// Origen de los contactos: Facebook Ads, Instagram, Web, Referido, etc.
model Source {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  color     String?
  createdAt DateTime @default(now())

  contacts  Contact[]
  users     UserSource[] // vendedores que atienden esta fuente
  metaPages MetaPage[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@map("sources")
}

// Qué fuentes atiende cada vendedor. El vendedor solo ve conversaciones de
// los contactos cuya fuente esté en esta lista.
model UserSource {
  userId   String
  sourceId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([userId, sourceId])
  @@index([sourceId])
  @@map("user_sources")
}

model Tag {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  color     String?
  waLabelId String? // id de la etiqueta en la app (coexistencia)
  createdAt DateTime @default(now())

  contacts  ContactTag[]
  campaigns CampaignTag[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@unique([orgId, waLabelId])
  @@map("tags")
}

// Join explícito Contact <-> Tag (permite metadatos en la relación a futuro).
model ContactTag {
  contactId  String
  tagId      String
  assignedAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

// ─────────────────────────────────────────────────────────────
// Conversaciones / Mensajes
// ─────────────────────────────────────────────────────────────

model Conversation {
  id              String             @id @default(cuid())
  orgId           String
  contactId       String
  channelId       String? // por qué número de WhatsApp entró (multi-número)
  assignedAgentId String?
  status          ConversationStatus @default(OPEN)
  windowExpiresAt DateTime? // ventana de 24h de WhatsApp
  aiMode          AiMode             @default(COPILOT)
  aiPausedUntil   DateTime? // si un humano interviene, la IA se pausa hasta esta hora
  // La IA pasó el chat a una persona: cuándo y por qué. Se limpia al atenderlo.
  handoffAt       DateTime?
  handoffReason   String?
  // Anuncio Click-to-WhatsApp que abrió ESTA conversación (payload `referral`
  // de Meta: id del anuncio, ctwa_clid, titular…). Null si no vino de un anuncio.
  referral        Json?
  awaitingReply   Boolean            @default(false) // el contacto escribió y aún no respondemos
  lastMessageAt   DateTime?
  // Mensajes del contacto desde la última vez que alguien abrió el chat.
  unreadCount     Int                @default(0)
  lastReadAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  contact       Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       WhatsappConnection? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  assignedAgent User?               @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages      Message[]
  notes         Note[]
  calls         Call[]
  aiRuns        AiRun[]
  aiMessages    AiMessage[]
  flowSession   FlowSession?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([channelId])
  @@index([assignedAgentId])
  @@index([aiMode])
  @@index([orgId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  orgId          String
  conversationId String
  waMessageId    String?          @unique // idempotencia: eventos duplicados se ignoran
  // Mensaje al que este responde (cita estilo WhatsApp). Self-relation.
  replyToId      String?
  direction      MessageDirection
  type           MessageType
  author         MessageAuthor
  content        String? // texto o caption
  mediaUrl       String?
  // Lo que la IA entendió del medio: transcripción del audio o descripción de
  // la imagen/sticker. Null = sin procesar; "" = no se pudo.
  transcript     String?
  // Botones enviados (mensaje interactivo) o botón que pulsó el contacto.
  interactive    Json?
  buttonPayload  String?
  templateId     String?
  campaignId     String? // si el mensaje salió de una campaña/broadcast
  reaction       String? // emoji de reacción sobre este mensaje (o null si se quitó)
  status         MessageStatus    @default(QUEUED)
  // Trazabilidad: si lo generó la IA, enlaza al run que lo produjo.
  aiRunId        String?
  errorReason    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Si se borra el citado, la cita se queda en null en vez de arrastrar el mensaje.
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")
  template     Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  aiRun        AiRun?       @relation(fields: [aiRunId], references: [id], onDelete: SetNull)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([orgId, createdAt])
  @@index([replyToId])
  @@index([status])
  @@index([campaignId])
  @@map("messages")
}

// Notas internas (no se envían al contacto).
model Note {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("notes")
}

// ─────────────────────────────────────────────────────────────
// Plantillas / Campañas
// ─────────────────────────────────────────────────────────────

model Template {
  id             String           @id @default(cuid())
  orgId          String
  waTemplateId   String?
  wabaId         String? // cuenta de WhatsApp Business donde vive
  name           String
  language       String           @default("es")
  category       TemplateCategory @default(MARKETING)
  status         TemplateStatus   @default(PENDING)
  // Componentes según Meta: header { format, text?, example? } y buttons[].
  header         Json?
  body           String
  footer         String?
  buttons        Json?
  variables      Json? // definición de variables/posiciones
  // Motivo del rechazo que informa Meta, para mostrarlo en el panel.
  rejectedReason String?
  // Importada de Meta con componentes que el editor no cubre: no se edita.
  readOnly       Boolean          @default(false)
  syncedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  campaigns Campaign[]
  messages  Message[]
  metaPages MetaPage[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, waTemplateId])
  // Meta identifica una plantilla por nombre + idioma, pero eso vale DENTRO de
  // una WABA. Dos empresas distintas pueden tener cada una su plantilla
  // "bienvenida" en español, y con la restricción global la segunda no podría
  // crearla. Por eso lleva orgId delante, igual que el resto.
  @@unique([orgId, name, language])
  @@map("templates")
}

// ─────────────────────────────────────────────────────────────
// Formularios de Meta (Lead Ads)
// ─────────────────────────────────────────────────────────────

// Página de Facebook conectada. Su token es de página (no de usuario): es el
// que Meta exige para suscribirse a `leadgen` y para leer cada lead.
model MetaPage {
  id                String    @id @default(cuid())
  // Sus dos relaciones (source, template) son opcionales: una página sin
  // ninguna de las dos no colgaría de nadie. Lleva la columna como raíz.
  orgId             String
  // El pageId sigue siendo único global: una página de Facebook pertenece a
  // una sola empresa, igual que un número de WhatsApp.
  pageId            String    @unique
  name              String
  accessToken       String
  isActive          Boolean   @default(true)
  subscribedAt      DateTime?
  // Qué hacer con los leads de esta página.
  sourceId          String? // fuente comercial que se asigna al contacto
  tagIds            Json? // etiquetas a aplicar
  createDeal        Boolean   @default(false)
  welcomeTemplateId String? // plantilla de WhatsApp de bienvenida
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  source   Source?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  template Template?    @relation(fields: [welcomeTemplateId], references: [id], onDelete: SetNull)
  leads    MetaLead[]

  @@index([orgId])
  @@map("meta_pages")
}

enum MetaLeadStatus {
  PROCESSED // se creó o actualizó el contacto
  NO_PHONE // el formulario no trajo teléfono: queda para revisar
  ERROR
}

// Cada lead recibido. Sirve de bandeja para los que llegan sin teléfono y
// evita duplicados: Meta reintenta el webhook si no responde a la primera.
model MetaLead {
  id        String         @id @default(cuid())
  leadgenId String         @unique
  pageId    String
  formId    String?
  formName  String?
  adId      String?
  fieldData Json // respuestas tal cual las manda Meta
  name      String?
  phone     String?
  email     String?
  status    MetaLeadStatus @default(PROCESSED)
  error     String?
  contactId String?
  createdAt DateTime       @default(now())

  page    MetaPage @relation(fields: [pageId], references: [pageId], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([pageId])
  @@map("meta_leads")
}

// Respuestas rápidas del agente: texto guardado que se inserta en el chat
// dentro de la ventana de 24h (no necesitan aprobación de Meta).
model QuickReply {
  id        String       @id @default(cuid())
  orgId     String
  // El atajo es único DENTRO de la empresa: dos negocios distintos pueden
  // tener cada uno su "/precio".
  shortcut  String // "/precio"
  title     String
  body      String
  mediaUrl  String? // referencia "storage://…" opcional
  mediaType MessageType?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, shortcut])
  @@map("quick_replies")
}

model Campaign {
  id              String         @id @default(cuid())
  name            String
  templateId      String
  channelId       String? // número de WhatsApp emisor (multi-número)
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  variableValues  Json? // valores de las variables de la plantilla para este envío
  // Métricas agregadas (también derivables de Message, cacheadas aquí).
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  deliveredCount  Int            @default(0)
  readCount       Int            @default(0)
  failedCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  template Template            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  channel  WhatsappConnection? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  tags     CampaignTag[] // audiencia: contactos con estas etiquetas
  messages Message[]

  @@index([status])
  @@map("campaigns")
}

model CampaignTag {
  campaignId String
  tagId      String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([campaignId, tagId])
  @@map("campaign_tags")
}

// ─────────────────────────────────────────────────────────────
// Pipeline / Deals
// ─────────────────────────────────────────────────────────────

// Columnas del kanban (configurables, ordenadas).
// Un embudo de la empresa. Puede haber varios (Ventas, Soporte, Renovaciones…)
// y uno es el predeterminado. La entrada automática de WhatsApp se configura
// aquí: al primer mensaje de un contacto sin oportunidad abierta se crea una
// en `inboundStageId` (o en la primera etapa) y, si nadie la atiende en
// `inboundDiscardDays`, se descarta sola.
model Pipeline {
  id                 String   @id @default(cuid())
  orgId              String
  name               String
  order              Int      @default(0)
  isDefault          Boolean  @default(false)
  inboundEnabled     Boolean  @default(false)
  inboundStageId     String?
  inboundDiscardDays Int      @default(7) // 0 = nunca
  // Agente de IA que atiende las conversaciones cuya oportunidad está en
  // este embudo. Null = el del número / el predeterminado. La etapa manda.
  botId              String?
  createdAt          DateTime @default(now())

  stages   PipelineStage[]
  bot      AgentConfig?         @relation("PipelineBot", fields: [botId], references: [id], onDelete: SetNull)
  channels WhatsappConnection[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(cuid())
  orgId       String
  pipelineId  String
  name        String
  order       Int
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  // «Potencial»: aquí llegan los que muestran interés real (mark_lead).
  isQualified Boolean  @default(false)
  createdAt   DateTime @default(now())

  deals       Deal[]
  automations StageAutomation[]
  pipeline    Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, order])
  @@index([orgId])
  @@map("pipeline_stages")
}

model Deal {
  id            String    @id @default(cuid())
  orgId         String
  contactId     String
  stageId       String
  ownerId       String? // vendedor responsable del deal
  title         String
  value         Decimal?  @db.Decimal(12, 2)
  currency      String    @default("USD")
  // Descartada: no era una venta (soporte, spam…) o nadie la atendió a tiempo.
  // No se borra: cuenta para el embudo y vuelve sola si el contacto escribe.
  discardedAt   DateTime?
  discardReason String? // "manual" | "auto" | texto libre
  // Cuándo entró en una etapa de ganado o perdido. Lo mantiene un trigger de
  // la base (migración deal_closed_at), venga el cambio de donde venga.
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contact        Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage          PipelineStage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner          User?                @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  automationRuns StageAutomationRun[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([orgId, stageId])
  @@index([orgId, discardedAt])
  @@index([ownerId])
  @@map("deals")
}

// ─────────────────────────────────────────────────────────────
// IA: configuración, runs, tool calls, memoria
// ─────────────────────────────────────────────────────────────

model AgentConfig {
  id                 String   @id @default(cuid())
  // El bot de respaldo no tiene canal (channelId null), así que no hereda la
  // organización de nadie: la lleva encima.
  orgId              String
  name               String
  systemPrompt       String
  model              String   @default("claude-opus-4-8")
  effort             String   @default("medium") // low | medium | high | xhigh | max
  enabledTools       String[] // nombres de tools habilitadas
  maxIterations      Int      @default(6)
  escalationRules    Json? // umbrales: confianza, sentimiento, palabras clave
  monthlyTokenBudget Int      @default(0) // 0 = sin límite
  isDefault          Boolean  @default(false) // bot global de respaldo
  isActive           Boolean  @default(true)

  // ── Asignación a canal (multi-número) ──────────────────────
  // Si channelId está fijo, este bot atiende ese número de WhatsApp.
  // Si es null y isDefault, es el bot de respaldo para canales sin bot.
  channelId String? @unique

  // ── Automatización ─────────────────────────────────────────
  autopilotByDefault   Boolean @default(false) // conversaciones nuevas arrancan en AUTOPILOT
  replyDelaySec        Int     @default(4) // espera desde el último mensaje del cliente antes de responder (0 = al instante)
  welcomeEnabled       Boolean @default(false)
  welcomeMessage       String? // saludo automático al primer mensaje
  businessHoursEnabled Boolean @default(false)
  businessHours        Json? // { timezone, days, outOfHoursMessage }
  keywordTriggers      Json? // [{ keywords[], action, value? }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel   WhatsappConnection? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  pipelines Pipeline[]          @relation("PipelineBot")
  runs      AiRun[]

  @@index([orgId])
  @@index([isActive])
  @@map("agent_configs")
}

// Una "corrida" del agente: el procesamiento de un mensaje entrante.
model AiRun {
  id               String      @id @default(cuid())
  conversationId   String
  agentConfigId    String?
  status           AiRunStatus @default(RUNNING)
  model            String
  // Clasificación (output estructurado): intención, sentimiento, urgencia, etc.
  classification   Json?
  confidence       Float?
  escalationReason String?
  inputTokens      Int         @default(0)
  outputTokens     Int         @default(0)
  costUsd          Decimal     @default(0) @db.Decimal(10, 6)
  latencyMs        Int?
  createdAt        DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentConfig  AgentConfig? @relation(fields: [agentConfigId], references: [id], onDelete: SetNull)
  toolCalls    AiToolCall[]
  messages     Message[] // mensajes que este run produjo

  @@index([conversationId, createdAt])
  @@index([status])
  @@map("ai_runs")
}

// Cada invocación de herramienta dentro de un run (auditoría + aprobación).
model AiToolCall {
  id           String           @id @default(cuid())
  aiRunId      String
  toolName     String
  input        Json
  output       Json?
  status       AiToolCallStatus @default(PENDING_APPROVAL)
  approvedById String? // quién aprobó/rechazó en modo copilot
  errorReason  String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?

  aiRun      AiRun @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([aiRunId])
  @@index([status])
  @@map("ai_tool_calls")
}

// Historial canónico que se replica al LLM (incluye bloques de thinking/tool).
model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        Json // bloques de contenido (text, tool_use, tool_result)
  thinkingBlocks Json? // se devuelven sin modificar al continuar en el mismo modelo
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ─────────────────────────────────────────────────────────────
// RAG: base de conocimiento
// ─────────────────────────────────────────────────────────────

model KnowledgeDoc {
  id        String   @id @default(cuid())
  orgId     String
  title     String
  source    String? // url, nombre de archivo, etc.
  content   String
  metadata  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks KnowledgeChunk[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("knowledge_docs")
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  docId      String
  content    String
  tokenCount Int                          @default(0)
  // Embedding (Voyage AI voyage-3.5 → 1024 dims). Prisma no lee este campo ni
  // crea el índice: la búsqueda por similitud y el índice HNSW se hacen con SQL
  // crudo en una migración manual:
  //   CREATE INDEX ON knowledge_chunks USING hnsw (embedding vector_cosine_ops);
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime                     @default(now())

  doc KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@map("knowledge_chunks")
}

// ─────────────────────────────────────────────────────────────
// Conexión de WhatsApp (Cloud API / Coexistencia)
// ─────────────────────────────────────────────────────────────

// Credenciales de cada número de WhatsApp conectado (un canal por número),
// obtenidas vía Embedded Signup. El adaptador de Meta las lee en tiempo de
// ejecución (con fallback al .env). Pueden coexistir varias activas a la vez.
model WhatsappConnection {
  id                 String   @id @default(cuid())
  orgId              String
  wabaId             String? // WhatsApp Business Account ID
  phoneNumberId      String   @unique // identifica el canal de forma única
  displayPhoneNumber String? // el número en formato legible
  label              String? // alias visible ("Ventas", "Soporte", etc.)
  accessToken        String // token (largo) para enviar mensajes
  mode               String   @default("coexistence") // coexistence | api
  status             String   @default("connected") // connected | error
  statusReason       String? // motivo cuando status = error (token caducado…)
  isActive           Boolean  @default(true)
  // Embudo al que entran las conversaciones nuevas de este número. Null = el
  // predeterminado de la empresa.
  pipelineId         String?
  connectedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conversations Conversation[]
  bot           AgentConfig?
  flows         Flow[]
  campaigns     Campaign[]

  pipeline Pipeline?    @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([orgId])
  @@map("whatsapp_connections")
}

// ─────────────────────────────────────────────────────────────
// Flujos de automatización (constructor visual tipo nodos)
// ─────────────────────────────────────────────────────────────

// Definición de un flujo: nodos + aristas (formato React Flow) + disparador.
model Flow {
  id              String   @id @default(cuid())
  // Igual que AgentConfig: un flujo sin canal no cuelga de nada.
  orgId           String
  name            String
  isActive        Boolean  @default(false)
  channelId       String? // canal que dispara el flujo (null = cualquiera)
  triggerType     String   @default("conversation_start") // ver flowTriggerTypes en @crm/shared
  triggerKeywords String[] // si triggerType = keyword
  triggerConfig   Json     @default("{}") // filtros del disparador (etiquetas, etapas, formularios, horas)
  nodes           Json     @default("[]") // [{ id, type, position, data }]
  edges           Json     @default("[]") // [{ id, source, target, sourceHandle? }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org              Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel          WhatsappConnection? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  sessions         FlowSession[]
  stageAutomations StageAutomation[]

  @@index([orgId])
  @@index([isActive])
  @@map("flows")
}

// Estado de ejecución de un flujo en una conversación concreta.
model FlowSession {
  id             String   @id @default(cuid())
  conversationId String   @unique
  flowId         String
  currentNodeId  String? // nodo donde espera respuesta (askQuestion), o null
  variables      Json     @default("{}") // respuestas capturadas
  status         String   @default("running") // running | completed | stopped
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([flowId])
  @@map("flow_sessions")
}

// ─────────────────────────────────────────────────────────────
// Credenciales y preferencias del proveedor de IA
// ─────────────────────────────────────────────────────────────

// Fila única (singleton) editable desde Ajustes › Inteligencia Artificial.
// Las keys se guardan cifradas (AES-256-GCM). Si una key está vacía aquí,
// se usa la variable de entorno equivalente como respaldo.
model AiSetting {
  id       String @id @default(cuid())
  orgId    String @unique // una configuración de IA por organización
  provider String @default("auto") // auto | openai | anthropic | fake

  openaiKeyEnc    String? // cifrada; null = usar OPENAI_API_KEY del entorno
  anthropicKeyEnc String? // cifrada; null = usar ANTHROPIC_API_KEY del entorno

  openaiModel    String  @default("gpt-4o-mini")
  anthropicModel String  @default("claude-opus-4-8")
  openaiBaseUrl  String? // para gateways compatibles con OpenAI

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

// ─────────────────────────────────────────────────────────────
// Claves de API emitidas por el CRM (integraciones entrantes)
// ─────────────────────────────────────────────────────────────

// Una clave por integración (n8n, Zapier, una landing…). Solo se guarda el
// hash del secreto: la clave completa se enseña una única vez al crearla.
model ApiKey {
  id          String    @id @default(cuid())
  orgId       String
  name        String // "n8n-formulario-web"
  prefix      String    @unique // "crm_a1b2c3d4": identifica sin revelar
  secretHash  String // SHA-256 del secreto completo
  scopes      String[] // leads:write, contacts:read…
  lastUsedAt  DateTime?
  useCount    Int       @default(0)
  revokedAt   DateTime? // revocada: deja de valer, pero queda el rastro
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User? @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([revokedAt])
  @@index([orgId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────
// Credenciales de terceros que el CRM consume (fila única)
// ─────────────────────────────────────────────────────────────

// Editable en Ajustes › Integraciones. Los secretos van cifrados; si están
// vacíos se usa la variable de entorno equivalente.
model IntegrationSetting {
  id    String @id @default(cuid())
  orgId String @unique // unas credenciales por organización

  voyageKeyEnc String? // null = usar VOYAGE_API_KEY del entorno
  voyageModel  String  @default("voyage-3.5")

  whatsappAppId          String?
  whatsappAppSecretEnc   String?
  whatsappVerifyTokenEnc String?
  whatsappGraphVersion   String  @default("v21.0")

  // Llamadas telefónicas (Twilio), por empresa. El auth token firma los
  // webhooks; la API key emite los tokens del softphone; la TwiML App la crea
  // Driony al activar.
  twilioAccountSid      String?
  twilioAuthTokenEnc    String?
  twilioApiKeySid       String?
  twilioApiKeySecretEnc String?
  twilioNumber          String? // E.164 del número de Twilio
  twilioAppSid          String? // TwiML App creada por Driony
  twilioRecord          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("integration_settings")
}

// ─────────────────────────────────────────────────────────────
// Llamadas telefónicas (Twilio o registradas a mano)
// ─────────────────────────────────────────────────────────────

model Call {
  id             String    @id @default(cuid())
  orgId          String
  contactId      String?
  conversationId String?
  agentId        String? // quien llamó o contestó
  direction      String // INBOUND | OUTBOUND
  status         String    @default("queued") // queued | ringing | in_progress | completed | missed | no_answer | busy | failed | canceled
  provider       String    @default("twilio") // twilio | manual
  providerSid    String?   @unique // CallSid de Twilio
  fromNumber     String
  toNumber       String
  startedAt      DateTime?
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSec    Int?
  recordingSid   String?
  recordingUrl   String? // referencia interna de almacenamiento (storage://id)
  transcript     String?
  outcome        String? // answered | no_answer | voicemail | busy | wrong_number | callback
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  agent        User?         @relation("CallAgent", fields: [agentId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([contactId])
  @@index([conversationId])
  @@map("calls")
}

// ─────────────────────────────────────────────────────────────
// Webhooks salientes: el CRM avisa a sistemas externos
// ─────────────────────────────────────────────────────────────

// Una suscripción por destino. El `secret` firma cada entrega (HMAC-SHA256)
// para que el receptor pueda verificar que el aviso viene de este CRM.
model WebhookSubscription {
  id       String   @id @default(cuid())
  orgId    String
  name     String // "n8n · pedidos"
  url      String
  events   String[] // message.received, deal.won…
  secret   String // se muestra una vez al crearla
  isActive Boolean  @default(true)

  // Diagnóstico: por qué dejó de funcionar sin tener que mirar logs.
  lastStatus     Int? // código HTTP de la última entrega
  lastError      String?
  lastDeliveryAt DateTime?
  deliveredCount Int       @default(0)
  failedCount    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([orgId])
  @@map("webhook_subscriptions")
}

// ─────────────────────────────────────────────────────────────
// Automatizaciones de etapa: «cuando pase X en esta etapa, ejecuta el flujo Y»
// ─────────────────────────────────────────────────────────────

model StageAutomation {
  id           String   @id @default(cuid())
  orgId        String
  stageId      String
  trigger      String // enters_stage | inbound_message | webhook | no_reply (stageAutomationTriggers en @crm/shared)
  flowId       String
  delayMinutes Int? // no_reply: minutos sin respuesta del cliente
  token        String?  @unique // webhook: secreto de la URL pública
  enabled      Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org   Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stage PipelineStage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  flow  Flow                 @relation(fields: [flowId], references: [id], onDelete: Cascade)
  runs  StageAutomationRun[]

  @@index([orgId])
  @@index([stageId])
  @@index([flowId])
  @@map("stage_automations")
}

// Candado «una vez por estancia en la etapa» (no_reply). Se borra al cambiar de etapa.
model StageAutomationRun {
  id           String   @id @default(cuid())
  orgId        String
  automationId String
  dealId       String
  createdAt    DateTime @default(now())

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  automation StageAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  deal       Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([automationId, dealId])
  @@index([orgId])
  @@index([dealId])
  @@map("stage_automation_runs")
}

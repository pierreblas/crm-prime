{
  "name": "@crm/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:tenancy": "tsx --test test/tenancy.test.ts",
    "pretest:tenancy": "node ../../scripts/ensure-test-db.mjs crm_tenancy_test",
    "test:rls": "tsx --test test/rls.test.ts",
    "test:waphone": "tsx --test test/whatsapp-phone-pick.test.ts",
    "pretest:rls": "node ../../scripts/setup-rls-test-db.mjs",
    "test:slug": "tsx --test test/org-slug.test.ts",
    "test:cors": "tsx --test test/cors.test.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "test:joborg": "tsx --test test/job-org.test.ts",
    "test:subdomain": "tsx --test test/subdomain.test.ts",
    "test:tickets": "tsx --test test/one-time-ticket.test.ts",
    "test:inbound": "tsx --test test/inbound-origin.test.ts",
    "test:aikeys": "tsx --test test/ai-keys.test.ts",
    "test:intake": "tsx --test test/pipeline-intake.test.ts",
    "test:promptassist": "tsx --test test/prompt-assistant.test.ts",
    "test:money": "tsx --test test/money.test.ts",
    "test:onboarding": "tsx --test test/onboarding.test.ts",
    "test:plans": "tsx --test test/plans.test.ts",
    "test:copilot": "tsx --test test/copilot.test.ts",
    "test:dashboard": "tsx --test test/dashboard.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@crm/shared": "*",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "twilio": "^5.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
